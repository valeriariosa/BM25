  {"cell_type":"markdown","metadata":{},"source":["# BM25 - Buscador de ropa\n","Caso de uso: ordenar productos según la relevancia de la consulta."]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["!pip -q install rank_bm25\n","from rank_bm25 import BM25Okapi\n"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["productos_ropa = [\n"," 'Camisa Oxford Azul: camisa de algodón azul de corte clásico',\n"," 'Jean Slim Fit: pantalón vaquero ajustado azul',\n"," 'Vestido Floral: vestido de verano con estampado floral',\n"," 'Casaca Negra: chaqueta negra de acabado elegante',\n"," 'Camiseta Básica Blanca: camiseta blanca de algodón suave',\n"," 'Falda Midi Beige: falda midi plisada color beige',\n"," 'Suéter Cálido Gris: jersey de lana gris para invierno',\n"," 'Abrigo Largo Camel: abrigo de invierno largo color camel',\n"," 'Short Deportivo: pantalón corto deportivo para entrenamiento',\n"," 'Blusa Fiesta: blusa de seda elegante para fiestas'\n","]\n","corpus_ropa=[p.lower().split() for p in productos_ropa]\n","bm25_ropa=BM25Okapi(corpus_ropa)\n"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["query_input_ropa=input('Introduce tu consulta de ropa (ej. vestido floral): ')\n","query_ropa=query_input_ropa.lower().split()\n","print(f'Tu consulta procesada es: {query_ropa}')\n","scores_ropa=bm25_ropa.get_scores(query_ropa)\n","resultados=sorted(zip(productos_ropa,scores_ropa),key=lambda x:x[1],reverse=True)\n","for producto,score in resultados:\n","    print(f'{producto} -> score: {score:.4f}')\n"]}
